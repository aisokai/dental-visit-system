# src/firebase.js で使用。Firebaseコンソール > プロジェクトの設定 > 全般 から取得
# VITE_ プレフィックスの変数はブラウザに公開されます。シークレット情報は含めないこと。
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# クリニック情報（PdfExportButton で使用）
# VITE_ プレフィックスの値はビルド成果物に含まれブラウザから参照可能です。
VITE_CLINIC_NAME=クリニック名
VITE_CLINIC_POSTAL=〒XXX-XXXX
VITE_CLINIC_ADDRESS=（住所）
VITE_CLINIC_TEL=XX-XXXX-XXXX
VITE_CLINIC_FAX=XX-XXXX-XXXX
VITE_CLINIC_CONTACT=事務局
